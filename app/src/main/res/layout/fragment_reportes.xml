<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Barra superior azul idéntica a Pantalla: Reportes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_blue"
        android:gravity="center"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_reportes"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Campo selector Fecha Inicio: Desde: 01/09/2026 -->
            <EditText
                android:id="@+id/etFechaDesde"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/bg_rounded_input"
                android:clickable="true"
                android:focusable="false"
                android:hint="Desde: 01/09/2026"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Campo selector Fecha Fin: Hasta: 12/09/2026 -->
            <EditText
                android:id="@+id/etFechaHasta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rounded_input"
                android:clickable="true"
                android:focusable="false"
                android:hint="Hasta: 12/09/2026"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Spinner Tipo de residuo ▼ (todos) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rounded_input">

                <Spinner
                    android:id="@+id/spTipoResiduoReporte"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </FrameLayout>

            <!-- Botón azul FILTRAR -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFiltrar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary_blue"
                android:text="@string/btn_filtrar"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Lista de resultados en tarjetas idéntica al wireframe -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResumenReporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_reporte_resumen" />

            <!-- Fila de Total Consolidado -->
            <LinearLayout
                android:id="@+id/layoutTotalConsolidado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rounded_input"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TOTAL GENERAL"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalConsolidadoKg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="415.0 kg"
                    android:textColor="@color/primary_blue_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botón naranja EXPORTAR / COMPARTIR -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnExportarCompartir"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="26dp"
                android:background="@drawable/btn_accent_orange"
                android:text="@string/btn_exportar_compartir"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
